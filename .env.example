# Variáveis de Ambiente da Aplicação RB Agronegócios

# Porta do servidor (definida automaticamente no Railway)
PORT=3000

# Token da API FIPE (Parallelum) - Necessário para busca de veículos e valores FIPE
FIPE_API_TOKEN=

# URL do Banco de Dados PostgreSQL (Preenchida automaticamente pelo Railway ao adicionar o banco PostgreSQL)
DATABASE_URL=postgresql://postgres:senha@host:5432/railway

